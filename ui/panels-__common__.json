      "panelHtml": "<div style=\"display: flex; flex-direction: column; height: 100%; background: var(--bg-main); color: var(--text); font-family: var(--font-family);\">\n  \n  <!-- ヘッダー -->\n  <div style=\"padding: 16px; border-bottom: 1px solid var(--border); background: var(--bg-card); display: flex; justify-content: space-between; align-items: center;\">\n    <h1 style=\"margin: 0; font-size: 18px; font-weight: 600;\">リマインド通知管理</h1>\n    <button class=\"action-btn secondary\" data-testid=\"settings-button\" style=\"width: 36px; height: 36px; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-control); border: 1px solid var(--border); background: transparent; cursor: pointer;\">\n      ⚙️\n    </button>\n  </div>\n\n  <!-- メインコンテンツ（スクロール可能） -->\n  <div style=\"flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 16px;\">\n    \n    <!-- 次回送信予定カード -->\n    <div class=\"card\" style=\"background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-card); padding: 16px; box-shadow: var(--shadow-card);\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;\">\n        <div>\n          <p style=\"margin: 0 0 4px 0; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;\">次回送信予定</p>\n          <p data-testid=\"next-send-time\" style=\"margin: 0; font-size: 20px; font-weight: 700; color: var(--primary);\">--:--</p>\n        </div>\n        <div style=\"text-align: right;\">\n          <p style=\"margin: 0 0 4px 0; font-size: 12px; color: var(--text-muted);\">報告期限まで</p>\n          <p data-testid=\"time-remaining\" style=\"margin: 0; font-size: 16px; font-weight: 600; color: var(--text);\">-- 時間 -- 分</p>\n        </div>\n      </div>\n      <div style=\"font-size: 13px; color: var(--text-muted); padding-top: 12px; border-top: 1px solid rgba(148, 163, 184, 0.1);\">\n        <p data-testid=\"next-send-target\" style=\"margin: 8px 0 0 0;\">対象: <span style=\"color: var(--text);\">--</span></p>\n      </div>\n    </div>\n\n    <!-- アクティブスケジュール一覧 -->\n    <div>\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\">\n        <h2 style=\"margin: 0; font-size: 14px; font-weight: 600; color: var(--text);\">アクティブスケジュール</h2>\n        <span data-testid=\"active-count\" style=\"font-size: 12px; color: var(--text-muted); background: rgba(99, 102, 241, 0.1); padding: 4px 8px; border-radius: var(--radius-control);\">0 件</span>\n      </div>\n      <div id=\"schedules-list\" style=\"display: flex; flex-direction: column; gap: 8px;\">\n        <!-- スケジュール行がここに動的に挿入される -->\n      </div>\n      <div id=\"schedules-empty\" style=\"text-align: center; padding: 24px 16px; color: var(--text-muted); font-size: 13px;\">\n        スケジュールがありません\n      </div>\n    </div>\n\n    <!-- 最新リマインド送信履歴 -->\n    <div>\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\">\n        <h2 style=\"margin: 0; font-size: 14px; font-weight: 600; color: var(--text);\">最新送信履歴</h2>\n        <a href=\"#\" data-testid=\"view-all-history\" style=\"font-size: 12px; color: var(--primary); text-decoration: none; cursor: pointer;\">すべて見る →</a>\n      </div>\n      <div id=\"history-list\" style=\"display: flex; flex-direction: column; gap: 8px;\">\n        <!-- 履歴行がここに動的に挿入される -->\n      </div>\n      <div id=\"history-empty\" style=\"text-align: center; padding: 24px 16px; color: var(--text-muted); font-size: 13px;\">\n        送信履歴がありません\n      </div>\n    </div>\n\n  </div>\n\n  <!-- フローティングボタン（新規作成） -->\n  <button class=\"action-btn\" data-testid=\"create-schedule-button\" style=\"position: fixed; bottom: 80px; right: 16px; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4); z-index: 50;\">\n    +\n  </button>\n\n</div>\n\n<!-- 新規スケジュール作成モーダル -->\n<div id=\"create-modal\" class=\"modal-overlay\" style=\"display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center;\">\n  <div style=\"background: var(--bg-card); color: var(--text); padding: 24px; border-radius: var(--radius-card); max-width: 90vw; max-height: 90vh; overflow: auto; box-shadow: 0 8px 32px rgba(0,0,0,0.4); width: 100%; max-width: 420px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h3 style=\"margin: 0; font-size: 16px; font-weight: 600;\">新規スケジュール作成</h3>\n      <button id=\"close-create-modal\" style=\"background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; padding: 0; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;\">×</button>\n    </div>\n\n    <form id=\"create-form\" style=\"display: flex; flex-direction: column; gap: 16px;\">\n      \n      <!-- 送信時刻 -->\n      <div>\n        <label style=\"display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;\">送信時刻</label>\n        <input type=\"time\" name=\"send_time\" data-testid=\"send-time-input\" style=\"width: 100%; padding: 8px 12px; border: 1px solid rgba(255,255,255,0.18); background: var(--bg-main); color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-family: var(--font-family);\" required />\n      </div>\n\n      <!-- 対象チーム -->\n      <div>\n        <label style=\"display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;\">対象チーム</label>\n        <select name=\"team_id\" data-testid=\"team-select\" style=\"width: 100%; padding: 8px 12px; border: 1px solid rgba(255,255,255,0.18); background: var(--bg-main); color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-family: var(--font-family);\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"team-1\">営業チーム</option>\n          <option value=\"team-2\">企画チーム</option>\n          <option value=\"team-3\">開発チーム</option>\n          <option value=\"team-4\">全社</option>\n        </select>\n      </div>\n\n      <!-- 報告期限（時間） -->\n      <div>\n        <label style=\"display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: 500;\">報告期限（送信後、何時間以内に報告）</label>\n        <input type=\"number\" name=\"deadline_hours\" data-testid=\"deadline-hours-input\" min=\"1\" max=\"24\" value=\"8\" style=\"width: 100%; padding: 8px 12px; border: 1px solid rgba(255,255,255,0.18); background: var(--bg-main); color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-family: var(--font-family);\" />\n      </div>\n\n      <!-- 有効/無効 -->\n      <div style=\"display: flex; align-items: center; gap: 12px;\">\n        <input type=\"checkbox\" name=\"is_active\" data-testid=\"is-active-checkbox\" checked style=\"accent-color: var(--primary); cursor: pointer;\" />\n        <label style=\"font-size: 13px; color: var(--text); cursor: pointer; margin: 0;\">作成後すぐに有効にする</label>\n      </div>\n\n      <!-- ボタン群 -->\n      <div style=\"display: flex; gap: 12px; margin-top: 20px;\">\n        <button type=\"button\" id=\"cancel-create-button\" class=\"action-btn secondary\" style=\"flex: 1; padding: 10px; border: 1px solid var(--border); background: transparent; color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n          キャンセル\n        </button>\n        <button type=\"submit\" class=\"action-btn\" data-testid=\"save-schedule-button\" style=\"flex: 1; padding: 10px; background: var(--primary); color: #fff; border: none; border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n          作成\n        </button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<!-- スケジュール詳細・編集モーダル -->\n<div id=\"detail-modal\" class=\"modal-overlay\" style=\"display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center;\">\n  <div style=\"background: var(--bg-card); color: var(--text); padding: 24px; border-radius: var(--radius-card); max-width: 90vw; max-height: 90vh; overflow: auto; box-shadow: 0 8px 32px rgba(0,0,0,0.4); width: 100%; max-width: 420px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h3 style=\"margin: 0; font-size: 16px; font-weight: 600;\">スケジュール詳細</h3>\n      <button id=\"close-detail-modal\" style=\"background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; padding: 0; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;\">×</button>\n    </div>\n\n    <div id=\"detail-content\" style=\"display: flex; flex-direction: column; gap: 16px;\">\n      <!-- 詳細情報がここに動的に挿入される -->\n    </div>\n\n    <div style=\"display: flex; gap: 12px; margin-top: 20px;\">\n      <button type=\"button\" id=\"delete-schedule-button\" class=\"action-btn secondary\" style=\"flex: 1; padding: 10px; border: 1px solid rgba(239, 68, 68, 0.3); background: transparent; color: #ef4444; border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n        削除\n      </button>\n      <button type=\"button\" id=\"close-detail-button\" class=\"action-btn secondary\" style=\"flex: 1; padding: 10px; border: 1px solid var(--border); background: transparent; color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n        閉じる\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- 削除確認ダイアログ -->\n<div id=\"delete-confirm-modal\" class=\"modal-overlay\" style=\"display: none; position: fixed; inset: 0; z-index: 1001; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center;\">\n  <div style=\"background: var(--bg-card); color: var(--text); padding: 24px; border-radius: var(--radius-card); max-width: 90vw; max-width: 360px; box-shadow: 0 8px 32px rgba(0,0,0,0.4);\">\n    <h3 style=\"margin: 0 0 12px 0; font-size: 16px; font-weight: 600;\">スケジュールを削除しますか？</h3>\n    <p style=\"margin: 0 0 20px 0; font-size: 13px; color: var(--text-muted);\">この操作は取り消せません。</p>\n    <div style=\"display: flex; gap: 12px;\">\n      <button type=\"button\" id=\"cancel-delete-button\" class=\"action-btn secondary\" style=\"flex: 1; padding: 10px; border: 1px solid var(--border); background: transparent; color: var(--text); border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n        キャンセル\n      </button>\n      <button type=\"button\" id=\"confirm-delete-button\" style=\"flex: 1; padding: 10px; background: #ef4444; color: #fff; border: none; border-radius: var(--radius-control); font-size: 14px; font-weight: 500; cursor: pointer;\">\n        削除\n      </button>\n    </div>\n  </div>\n</div>",
